#!/bin/bash
pushd "$(dirname "$0")" >/dev/null
ximea_dir="$(dirname "$PWD")"
popd > /dev/null
if [ -z "$LD_LIBRARY_PATH" ]
then
	export LD_LIBRARY_PATH="$ximea_dir/CamTool:$ximea_dir/lib"
else
	export LD_LIBRARY_PATH="$ximea_dir/CamTool:$ximea_dir/lib:$LD_LIBRARY_PATH"
fi
export QT_QPA_PLATFORM=xcb
exec $ximea_dir/CamTool/xiCamTool
